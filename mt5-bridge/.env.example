# ════════════════════════════════════════════════════════════════════════════
# ZYSB — Yemen Smart Bridge v3.0 — متغيرات البيئة
# ════════════════════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env في نفس مجلد bridge.py
# ثم عدّل القيم وفقًا لجلستك
#
# تثبيت المتطلبات (مرة واحدة):
#   pip install -r requirements.txt
#
# التشغيل:
#   copy .env.example .env   (عدّل القيم ثم)
#   python bridge.py
#
# أو متغيرات البيئة مباشرة في CMD:
#   set NEXUS_URL=https://preview-chat-<chat_id>.space-z.ai
#   set NEXUS_BRIDGE_TOKEN=nxb-xxxxxxxxxxxxxxxx
#   python bridge.py
# ════════════════════════════════════════════════════════════════════════════

# ── اختياري: اسم الجسر (للتمييز في السجلات والـ banner) ─────────────────────
# ZYSB = Yemen Smart Bridge — يُميّز هذا الجسر عن أي جسور أخرى على نفس الجهاز
# الاسم يظهر في: banner بدء التشغيل، كل سطر سجل، User-Agent HTTP،
#               حقل bridge_name في نبضات الحالة، اسم ملف السجل الافتراضي
# BRIDGE_NAME=ZYSB

# ── إلزامي: رابط نظام Nexus ─────────────────────────────────────────────────
# الرابط الكامل للوحة التحكم. يتغير مع كل جلسة دردشة جديدة على Z.ai.
#
# مثال لجلسة على Z.ai:
#   NEXUS_URL=https://preview-chat-d0892827-2907-4791-a397-f9ce9bb5fda4.space-z.ai
#
# مثال للاختبار المحلي:
#   NEXUS_URL=http://localhost:3000
NEXUS_URL=https://preview-chat-<chat_id>.space-z.ai

# ── إلزامي: توكن الجسر ──────────────────────────────────────────────────────
# نفس قيمة NEXUS_BRIDGE_TOKEN الموجودة في ملف .env على خادم Nexus
# ⚠️ استبدل nxb-xxxxxxxxxxxxxxxx بالتوكن الفعلي من .env على الخادم
NEXUS_BRIDGE_TOKEN=nxb-xxxxxxxxxxxxxxxx

# ── اختياري: الرموز المتداولة ───────────────────────────────────────────────
# قائمة مفصولة بفواصل. كل رمز يمكن أن يكون:
#   XAUUSD              (الاسم المنطقي = اسم الوسيط)
#   XAUUSD:GOLD         (الاسم المنطقي : اسم الوسيط الفعلي في MT5)
#   XAUUSD:GOLD,BTCUSD:BTCUSDm
# افتراضي: XAUUSD
BRIDGE_SYMBOLS=XAUUSD

# ── اختياري: توقيت سيرفر الوسيط ─────────────────────────────────────────────
# "auto" (موصى به) = يقيسه الجسر تلقائيًا من أحدث tick
# أو رقم ثابت مثل 2.0 / 3.0
# BRIDGE_SERVER_TZ_OFFSET=auto

# ── تردد الإرسال (مُحسّن لبوابة Z.ai) ──────────────────────────────────────
BRIDGE_POLL_TICKS_SEC=15.0
BRIDGE_POLL_BARS_SEC=120.0
BRIDGE_HEARTBEAT_SEC=120.0
BRIDGE_DECISION_POLL_SEC=300.0
BRIDGE_CALENDAR_POLL_SEC=600.0
BRIDGE_POSITIONS_POLL_SEC=60.0

# ── ضبط 429 (جديد) ──────────────────────────────────────────────────────────
BRIDGE_SKIP_SEED=true                  # تخطي seed_history (لـ Z.ai preview)
BRIDGE_REQUEST_DELAY_SEC=2.0           # تأخير بين الطلبات (ثانية)
BRIDGE_SEED_BARS=200                   # حجم أصغر لو فُعّل seed
BRIDGE_MAX_RETRIES=1                   # تقليل المحاولات
BRIDGE_RETRY_BACKOFF_SEC=5.0           # انتظار أطول بين المحاولات

# ── اختياري: التنفيذ ────────────────────────────────────────────────────────
# ⚠️ اتركها false أولًا — الجسر يرسل البيانات فقط. فعّلها بعد الاختبار.
# BRIDGE_EXECUTE=false
# BRIDGE_EXECUTE_VIA_API=true        # true = عبر API الخادم (موصى به)
#                                    # false = mt5.order_send مباشرة (تقليدي)
# BRIDGE_MIN_CONVICTION=65
# BRIDGE_LOT=0.01
# BRIDGE_SL_POINTS=300               # للذهب 300 نقطة ≈ 3$
# BRIDGE_TP_POINTS=600
# BRIDGE_ALLOW_REAL_ACCOUNT=false    # ⚠️ true فقط للحساب الحقيقي

# ── اختياري: التقويم الاقتصادي ──────────────────────────────────────────────
# BRIDGE_CALENDAR_FILE=zysb_calendar.json

# ── اختياري: إعادة المحاولة والتسجيل ────────────────────────────────────────
# (قيم إعادة المحاولة مضبوطة أعلاه في قسم "ضبط 429")
# BRIDGE_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# BRIDGE_LOG_FILE=zysb.log          # افتراضيًا <BRIDGE_NAME>.log
